# ===========================================
# OMS System - Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# --- Database (PostgreSQL via Supabase or standalone) ---
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db:5432/oms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=oms

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=true

# --- SlipOK (Slip Verification) ---
SLIPOK_API_URL=https://api.slipok.com/api/line/apikey
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Villa Info (for PDF templates) ---
VILLA_NAME=My Pool Villa
VILLA_ADDRESS=123 Example Road, Pattaya, Thailand
VILLA_PHONE=0xx-xxx-xxxx
VILLA_LINE_ID=@mypoolvilla
VILLA_TAX_ID=
